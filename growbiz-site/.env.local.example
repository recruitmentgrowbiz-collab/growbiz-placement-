# Copy this file to .env.local and fill in your own Supabase project values.
# Get these from your Supabase dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# PayU (optional — only needed for real plan-upgrade / Career Plus payments)
# Get these from your PayU dashboard: your Merchant Key and Salt
PAYU_MERCHANT_KEY=your_test_merchant_key
PAYU_SALT=your_test_salt
# "test" uses test.payu.in (safe, no real money); set to "production" to go live on secure.payu.in
PAYU_ENV=test

# Service role key (server-only, NEVER expose to the browser) — needed for the
# PayU success/failure callback routes to write to the database without a user session.
# Get this from Settings -> API -> service_role in your Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend (optional — only needed for actual email delivery)
# In-app notifications (the bell icon) work without this. Get your key from resend.com
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Grow Biz Jobs <notifications@yourdomain.com>

# App URL (used in email "manage preferences" links) — your real domain in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio (optional — only needed for SMS notifications)
# In-app + email notifications work without this. Get these from twilio.com
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1your_twilio_number

# Cron secret (required for /api/cron/maintenance — the job/membership expiry fallback)
# Generate any random string, e.g.: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# Resend webhook (optional — for real delivery/bounce tracking beyond "sent")
# Resend dashboard -> Webhooks -> add one pointing to /api/webhooks/resend,
# subscribe to email.sent/delivered/bounced/complained, copy its signing secret
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret

# Meilisearch (optional — dedicated search infrastructure, Phase 5)
# Without this, job search still works via PostgreSQL full-text/trigram search.
# Get a free instance at cloud.meilisearch.com, or self-host.
MEILISEARCH_HOST=https://your-instance.meilisearch.io
MEILISEARCH_API_KEY=your_api_key

# OpenAI (optional — AI features: job description assist, resume feedback, applicant summaries)
# Without this, the "Improve with AI" / "AI fit summary" / resume feedback buttons show
# a clear "not configured" message instead of erroring.
OPENAI_API_KEY=sk-your_openai_key
